# Environment Configuration Template for Code with Comali
# Copy this file to .env and configure your authoritative PostgreSQL credentials.
# NEVER commit your actual .env file to version control.

# PostgreSQL Connection String (Async driver for FastAPI & SQLAlchemy)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cwc_db

# Synchronous connection string for Alembic migrations (optional, Alembic can also use asyncpg)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/cwc_db

# Security & Session Authentication
# Generate a strong 32+ character random secret for production
SECRET_KEY=cwc_tournament_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Tournament Defaults
DEFAULT_SESSION_CODE=STG-TOURNAMENT-2025-Q1
DEFAULT_ADMIN_GM_ID=GM_ARBITER_07
DEFAULT_ADMIN_PASSWORD=admin_master_key_2026
